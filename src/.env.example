# Environment index; do not copy this whole file into a runtime .env.
# Backend: copy backend/.env.example to backend/.env (relative to src/).
# Frontend: copy frontend/.env.example to frontend/.env.
# Set real secrets only in ignored .env files or private hosting settings.
# Full defaults and descriptions: docs/setup-guide.md.
# APP_NAME=PortFlow AI API
# APP_ENV=development
# APP_VERSION=0.1.0
# API_V1_PREFIX=/api/v1
# DATABASE_URL=postgresql+psycopg://portflow:change-me@localhost:5432/portflow
# CORS_ORIGINS=["http://localhost:5173"]
# LOG_LEVEL=INFO
# SYNTHETIC_DATA_SEED=2026
# ML_ARTIFACT_DIR= (optional; defaults to src/ml/artifacts)
# COPILOT_PROVIDER= (empty selects rules_fallback)
# IBM_BOB_API_KEY= (private optional IBM Cloud API key)
# IBM_BOB_MODEL= (optional Watsonx deployment ID)
# IBM_BOB_BASE_URL= (optional regional ML service URL)
# VITE_API_BASE_URL=http://localhost:8000/api/v1
# VITE_DEFAULT_PORT_ID=FKPFL
# PORTFLOW_API_BASE=http://localhost:8000/api/v1 (MCP process)
