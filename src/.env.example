# src/.env.example — Environment Variable Index
#
# This file is an INDEX only. Do not put real values here.
# Real .env files are git-ignored. Copy the appropriate sub-module example:
#
#   src/backend/.env.example  →  src/backend/.env
#   src/frontend/.env.example →  src/frontend/.env
#
# Never commit real secrets, passwords, API keys, or IBM Cloud credentials.
#
# Key variables:
#   DATABASE_URL=postgresql+psycopg://portflow:change-me@localhost:5432/portflow
#   APP_ENV=development
#   SYNTHETIC_DATA_SEED=2026
